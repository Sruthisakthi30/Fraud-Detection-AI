.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large Model weights & temporary logs (Keep directories via .gitkeep)
models/*.joblib
models/*.npy
!models/.gitkeep
results/cases.db
results/reports/*.json
!results/reports/.gitkeep
!results/figures/.gitkeep
