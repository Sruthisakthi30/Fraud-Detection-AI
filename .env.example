# FraudShield AI - Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Application Mode
# Set to 1 to force demo mode when real creditcard.csv is absent
DEMO_MODE=0
